// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  piUserId     String         @unique
  username     String
  email        String?
  /// 'FREE' or 'PREMIUM'
  tier         String         @default("FREE")
  /// Bytes consumed so far; use BigInt to avoid overflow for multi-GB usage
  storageUsed  BigInt         @default(0)
  /// Bytes allowed for this tier; use BigInt to avoid overflow for multi-GB limits
  storageLimit BigInt         @default(524288000) // 500 MB default (FREE tier)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects     Project[]
  subscriptions Subscription[]
  piSubscriptions PiSubscription[]
  paymentQuotes PaymentQuote[]
  invoices      Invoice[]
  notifications Notification[]
}

model Project {
  id           String       @id @default(uuid())
  name         String
  description  String?
  customDomain String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  deployments  Deployment[]
  backendService BackendService?

  @@index([userId])
}

model Deployment {
  id        String   @id @default(uuid())
  /// IPFS content identifier
  cid       String   @default("")
  /// Public gateway URL
  gateway   String   @default("")
  /// File/directory size in bytes; use BigInt to avoid overflow for large uploads
  size      BigInt   @default(0)
  /// PENDING | UPLOADING | PINNING | ACTIVE | FAILED
  status    String   @default("PENDING")
  /// Human-readable failure detail (e.g. the real Pinata error) when status=FAILED.
  failureReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

/// A project's server-side backend (a service + Postgres database) provisioned
/// on the landlord provider (Railway) for projects that need a server. Created
/// only for PAID tiers; the front-end always still pins to IPFS. End users NEVER
/// see the provider — these provider ids are operator-only and must never leak.
model BackendService {
  id                      String   @id @default(uuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// PROVISIONING | ACTIVE | FAILED | DELETING | DELETED
  /// | PAUSE_PENDING (pause intended but not yet effected on the provider)
  /// | PAUSED (verified stopped on the provider) | RESUME_PENDING (resume not
  /// yet effected). A service is only ever marked PAUSED after a real, verified
  /// provider stop — never on a missing id, unconfigured provider, or error.
  status                  String   @default("PROVISIONING")
  /// Provider (Railway) identifiers — operator-only, never exposed to end users.
  railwayProjectId        String?
  railwayEnvironmentId    String?
  railwayBackendServiceId String?
  railwayDbServiceId      String?
  /// Public backend URL captured after the provider domain is created.
  publicUrl               String?
  /// Provider region the backend runs in, when known.
  region                  String?
  /// Whether scale-to-zero / sleep was enabled on the backend service.
  sleepEnabled            Boolean  @default(false)
  /// Real, sanitized failure detail when status=FAILED.
  failureReason           String?
  /// When the service was actually (verifiably) paused on the provider.
  pausedAt                DateTime?
  /// Why a pause/resume was initiated (e.g. "Invoice <id> overdue").
  pauseReason             String?
  /// Honest detail when a pause could NOT be effected (e.g. provider not
  /// configured, no provisioned service, stop/resume semantics unverified).
  pauseFailureReason      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
}

model Subscription {
  id          String   @id @default(uuid())
  /// 'FREE' or 'PREMIUM'
  tier        String
  piTxId      String?  @unique
  amount      Decimal  @db.Decimal(18, 8)
  currency    String
  /// 'active' or 'cancelled'
  status      String
  /// Pi environment the payment was made against: 'testnet' or 'mainnet'.
  env         String   @default("testnet")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// PiRC2 recurring subscription (Pi Network's on-chain subscription standard).
///
/// The subscriber grants a one-time spending allowance to the PiRC2 contract;
/// funds stay in their wallet and the billing scheduler draws one `amountPerCycle`
/// per interval (via the contract's transfer_from) until the allowance horizon
/// (`cyclesAuthorized`) is reached or the subscription is cancelled.
model PiSubscription {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  /// Granted tier while active (currently always 'PREMIUM').
  tier               String   @default("PREMIUM")
  /// PENDING_APPROVAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status             String   @default("PENDING_APPROVAL")
  /// On-chain account that granted the allowance.
  subscriberAddress  String?
  /// PiRC2 subscription smart-contract id this allowance targets.
  contractId         String?
  /// The on-chain tx hash that granted the spending allowance (one-time approval).
  approvalTxId       String?  @unique
  currency           String   @default("PI")
  /// Amount drawn each billing cycle.
  amountPerCycle     Decimal  @db.Decimal(18, 8)
  /// Total approved spending limit (amountPerCycle * cyclesAuthorized).
  allowanceTotal     Decimal  @db.Decimal(18, 8)
  /// Remaining un-drawn allowance.
  allowanceRemaining Decimal  @db.Decimal(18, 8)
  /// Billing interval length in days.
  intervalDays       Int      @default(30)
  /// Max number of cycles the allowance authorizes (billing horizon).
  cyclesAuthorized   Int
  /// Cycles successfully billed so far.
  cyclesBilled       Int      @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// When the next charge should be attempted (null once horizon reached).
  nextBillingAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  events             BillingEvent[]

  @@index([userId])
  @@index([status, nextBillingAt])
}

/// Immutable log of subscription lifecycle / on-chain billing events. These are
/// what the app tracks subscription status from.
model BillingEvent {
  id             String         @id @default(uuid())
  subscriptionId String
  subscription   PiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// APPROVAL | CHARGE | RENEWAL | CANCELLATION | INSUFFICIENT_FUNDS | EXPIRY
  type           String
  /// SUCCESS | FAILED
  status         String
  amount         Decimal?       @db.Decimal(18, 8)
  txId           String?
  periodStart    DateTime?
  periodEnd      DateTime?
  message        String?
  createdAt      DateTime       @default(now())

  @@index([subscriptionId])
}

model PaymentQuote {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  /// Catalog plan key being quoted: 'BUILDER' | 'PRO' | 'TIER4'.
  plan           String
  /// Dollar subtotal in integer cents (plan price + overage).
  dollarCents    Int
  /// Accrued overage in cents. Always 0 until Phase 4 metering exists.
  overageCents   Int      @default(0)
  /// Live Pi/USD rate this quote was priced at.
  piUsdRate      Decimal  @db.Decimal(18, 8)
  /// Where piUsdRate came from (matches PI_PRICE_SOURCE, e.g. 'coingecko').
  source         String
  /// When the source last observed that rate.
  observedAt     DateTime
  /// Conversion buffer applied, in basis points (default 400 = 4%).
  bufferBps      Int      @default(400)
  /// Pi owed = (dollar / piUsd) * (1 + buffer), rounded up to 7 dp.
  quotedPiAmount Decimal  @db.Decimal(18, 8)
  /// Pi environment this quote targets: 'testnet' | 'mainnet'.
  env            String   @default("testnet")
  /// PENDING | PAID | EXPIRED | CANCELLED
  status         String   @default("PENDING")
  /// Set once a Pi payment is created/linked against this quote.
  paymentId      String?  @unique
  /// On-chain tx hash once the linked payment completes.
  txid           String?  @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

/// A canonical, DOLLAR-denominated bill for one billing cycle. The dollar total
/// is the source of truth; the Pi amount is produced on demand via the Phase 5
/// quote engine at settlement time (and never blocks recording the debt). An
/// invoice records what is owed — creating or pricing one charges NOTHING.
model Invoice {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  /// Optional links to the subscription this cycle bills (no FK relation kept
  /// intentionally to avoid coupling the two billing models).
  subscriptionId   String?
  piSubscriptionId String?
  /// Catalog plan key this cycle bills (e.g. 'BUILDER' | 'PRO' | 'TIER4').
  plan           String
  cycleStart     DateTime
  cycleEnd       DateTime
  /// Plan subtotal in integer cents.
  subscriptionCents Int
  /// Accrued overage in cents. 0 until Phase 4 metering exists.
  overageCents   Int      @default(0)
  /// Where overageCents came from; 'METERING_DEFERRED' until Phase 4.
  overageSource  String   @default("METERING_DEFERRED")
  /// subscriptionCents + overageCents.
  totalCents     Int
  currency       String   @default("USD")
  /// OPEN | PAID | OVERDUE | VOID. (Pause state lives on BackendService.)
  status         String   @default("OPEN")
  dueAt          DateTime
  /// Apps may be paused once now > graceUntil and the invoice is still unpaid.
  graceUntil     DateTime
  paidAt         DateTime?
  /// Most recent Pi quote produced for settling this invoice (display only).
  latestPaymentQuoteId String?
  /// Set only once a real, verified Pi settlement is linked (deferred cutover).
  paymentId      String?  @unique
  txid           String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status, dueAt])
  @@index([status, graceUntil])
}

/// A user-facing, in-app notification (billing lifecycle, etc.). Email delivery
/// is intentionally not implemented yet; this store is the single source the
/// client reads and an email channel can later mirror.
model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// INVOICE_DUE | INVOICE_OVERDUE | APPS_PAUSED | APPS_RESUMED
  /// | CAP_WARNING_80 | CAP_REACHED_100 (cap types require Phase 4 metering and
  /// are never emitted until real usage data exists).
  type       String
  message    String
  /// Loosely links the notification to an invoice when relevant (no FK).
  invoiceId  String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  /// DB-level dedup for "notify once per event": at most one notification per
  /// (user, type, invoice). NULL invoiceId rows are exempt (Postgres treats
  /// NULLs as distinct), which is intended — only invoice-linked alerts dedup.
  @@unique([userId, type, invoiceId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}
