// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  // Emit the client into the SERVER package (the only runtime consumer) so the
  // built server (server/dist) always loads a client that matches this schema.
  // Without this, `prisma generate` writes to the repo-root node_modules while
  // the server resolves its own node_modules/.prisma/client — a stale copy that
  // silently omits the newest models (e.g. Watchdog), making db.<model> throw.
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  piUserId     String         @unique
  username     String
  /// 'FREE' or 'PREMIUM'
  tier         String         @default("FREE")
  /// Bytes consumed so far; use BigInt to avoid overflow for multi-GB usage
  storageUsed  BigInt         @default(0)
  /// Bytes allowed for this tier; use BigInt to avoid overflow for multi-GB limits
  storageLimit BigInt         @default(524288000) // 500 MB default (FREE tier)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects     Project[]
  subscriptions Subscription[]
  piSubscriptions PiSubscription[]
  paymentQuotes PaymentQuote[]
  invoices      Invoice[]
  notifications Notification[]
  supportTickets SupportTicket[]
}

model Project {
  id           String       @id @default(uuid())
  name         String
  description  String?
  customDomain String?
  /// App-deletion lifecycle (Phase 10). ACTIVE | DELETING | DELETED. A delete
  /// first marks DELETING, tears down provider resources + IPFS pins + private
  /// backups, and only marks DELETED after every teardown step is confirmed. If
  /// the provider/store is unreachable while resources still exist it STAYS
  /// DELETING with deletionFailureReason for retry — we never fake removal.
  lifecycleStatus      String   @default("ACTIVE")
  /// Honest detail when a teardown step could not be completed.
  deletionFailureReason String?
  /// When the app was fully, verifiably torn down.
  deletedAt            DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  deployments  Deployment[]
  backendService BackendService?

  @@index([userId])
  @@index([lifecycleStatus])
}

model Deployment {
  id        String   @id @default(uuid())
  /// IPFS content identifier
  cid       String   @default("")
  /// Public gateway URL
  gateway   String   @default("")
  /// File/directory size in bytes; use BigInt to avoid overflow for large uploads
  size      BigInt   @default(0)
  /// PENDING | UPLOADING | PINNING | ACTIVE | FAILED
  status    String   @default("PENDING")
  /// Human-readable failure detail (e.g. the real Pinata error) when status=FAILED.
  failureReason String?
  /// Entry file within the pinned directory (e.g. "index.html"); null for
  /// single-file pins and legacy rows. Live URLs point at this file so the
  /// gateway renders the site instead of a folder listing.
  entryPath String?
  /// Post-pin live-URL verification: UNCHECKED | VERIFIED | INDETERMINATE | FAILED.
  /// VERIFIED means the gateway actually returned the site's HTML — never claim
  /// "live" to the user on anything less.
  liveCheckStatus String    @default("UNCHECKED")
  /// Honest human-readable detail for INDETERMINATE / FAILED checks.
  liveCheckDetail String?
  liveCheckAt     DateTime?
  /// T2.1 AUP attestation — set when the user clicks "I agree" before publishing.
  /// A deployment MUST NOT be pinned unless this is set. The version is the
  /// CURRENT_AUP_VERSION constant at the time of attestation so we know which
  /// policy version was agreed to, and can require re-attestation when it bumps.
  attestationAcceptedAt  DateTime?
  attestedTermsVersion   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  watchdogChecks   WatchdogCheck[]
  watchdogIncidents WatchdogIncident[]

  @@index([projectId])
}

/// A project's server-side backend (a service + Postgres database) provisioned
/// on the landlord provider (Railway) for projects that need a server. Created
/// only for PAID tiers; the front-end always still pins to IPFS. End users NEVER
/// see the provider — these provider ids are operator-only and must never leak.
model BackendService {
  id                      String   @id @default(uuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// PROVISIONING | ACTIVE | FAILED | DELETING | DELETED
  /// | PAUSE_PENDING (pause intended but not yet effected on the provider)
  /// | PAUSED (verified stopped on the provider) | RESUME_PENDING (resume not
  /// yet effected). A service is only ever marked PAUSED after a real, verified
  /// provider stop — never on a missing id, unconfigured provider, or error.
  status                  String   @default("PROVISIONING")
  /// Provider (Railway) identifiers — operator-only, never exposed to end users.
  railwayProjectId        String?
  railwayEnvironmentId    String?
  railwayBackendServiceId String?
  railwayDbServiceId      String?
  /// Last Railway deployment id for the backend service. Used to verify the
  /// deploy actually reached a SUCCESS state before the service is marked ACTIVE
  /// — we never mark ACTIVE off an unverified or in-progress deploy.
  railwayDeploymentId     String?
  /// Public backend URL captured after the provider domain is created.
  publicUrl               String?
  /// Provider region the backend runs in, when known.
  region                  String?
  /// Whether scale-to-zero / sleep was enabled on the backend service.
  sleepEnabled            Boolean  @default(false)
  /// Real, sanitized failure detail when status=FAILED.
  failureReason           String?
  /// When the service was actually (verifiably) paused on the provider.
  pausedAt                DateTime?
  /// Why a pause/resume was initiated (e.g. "Invoice <id> overdue").
  pauseReason             String?
  /// Honest detail when a pause could NOT be effected (e.g. provider not
  /// configured, no provisioned service, stop/resume semantics unverified).
  pauseFailureReason      String?

  // --- Phase 7: idle-database cost control ---------------------------------
  // The DATABASE lifecycle is tracked separately from the service `status`
  // above; none of this ever touches the IPFS front-end (Deployment), which
  // stays live even when the backend DB is dormant or deleted.
  /// LIVE | DORMANT_PENDING | SNAPSHOT_PENDING | SNAPSHOTTED | DELETE_PENDING
  /// | DELETED | RESTORE_PENDING | RESTORE_FAILED. Only ever SNAPSHOTTED /
  /// DELETED / RESTORED after a real, verified operation — never on a deferred,
  /// disabled, or unconfigured path (those record an honest *_PENDING + reason).
  dbLifecycleStatus       String    @default("LIVE")
  /// Last time the provider showed non-trivial network activity for this app.
  /// Null until a trusted activity signal has actually been observed.
  lastProviderActivityAt  DateTime?
  /// Where lastProviderActivityAt came from (e.g. RAILWAY_ESTIMATED_USAGE).
  /// Null when no trusted activity signal exists yet — we never guess activity.
  activitySource          String?
  /// Last cumulative network usage (GB, RX+TX) observed for this app's project,
  /// used to detect a real positive delta between dormancy-reconciler polls.
  lastNetworkUsageGb      Float?
  /// When we FIRST established a real provider-activity baseline for this app.
  /// Dormancy is only ever measured from an observed window starting here (or
  /// from lastProviderActivityAt) — never from createdAt — so a single first
  /// poll on an old service can't be misread as days of inactivity.
  activityBaselineAt      DateTime?
  /// Last time the dormancy reconciler polled provider activity for this app.
  dbActivityCheckedAt     DateTime?
  /// When the DB was flagged dormant (intent), and the honest reason.
  dormantAt               DateTime?
  dormancyReason          String?
  /// Honest detail when a dormant snapshot/delete or a wake/restore could not
  /// be effected (provider not live, snapshot store not configured, etc.).
  dbDeleteFailureReason   String?
  dbRestoreFailureReason  String?

  // --- Phase 10: data safety (user-facing periodic backups) ----------------
  /// When the most recent DB backup was verifiably STORED. Null until a real,
  /// checksum-verified backup to a configured PRIVATE store has happened — never
  /// set on a deferred/blocked path. Surfaced to the owner as "last backup time".
  lastBackupAt            DateTime?
  /// Outcome of the most recent backup attempt: STORED | FAILED | PENDING.
  lastBackupStatus        String?
  /// Honest detail when the most recent backup could not be effected.
  lastBackupFailureReason String?

  // --- Phase 11: resilience to a backend-provider (Railway) outage ----------
  /// When set (and status is still PROVISIONING), a provider OUTAGE deferred
  /// provisioning and the retry reconciler should resume it no earlier than this
  /// time (capped exponential backoff). Null when there is no pending retry. An
  /// outage NEVER marks the service FAILED — it stays retryable so it self-heals
  /// when the provider returns, instead of failing permanently.
  provisioningNextRetryAt DateTime?
  /// How many times provisioning has been (re)attempted, for backoff + insight.
  provisioningAttemptCount Int     @default(0)

  snapshots               DbSnapshot[]
  backups                 DbBackup[]
  usageSamples            UsageSample[]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
  @@index([dbLifecycleStatus])
  /// Lets the outage retry reconciler cheaply find due PROVISIONING rows.
  @@index([status, provisioningNextRetryAt])
}

/// A point-in-time export of an app's Postgres database, taken before the live
/// Railway DB is deleted to stop billing (Phase 7 "dormant action"). A snapshot
/// is only ever STORED after a real, checksum-verified export to a configured
/// PRIVATE store — never on a deferred/unconfigured store, and raw dumps are
/// never placed on public IPFS. All fields here are operator-only.
model DbSnapshot {
  id               String         @id @default(uuid())
  backendServiceId String
  backendService   BackendService @relation(fields: [backendServiceId], references: [id], onDelete: Cascade)
  /// PENDING | EXPORTING | STORED | FAILED | RESTORING | RESTORED
  status           String         @default("PENDING")
  /// Opaque pointer to the configured private store + location; null until a
  /// real export to a real store has happened. Never exposed to end users.
  storageProvider  String?
  locationRef      String?
  /// Integrity check of the (encrypted) dump; set only when STORED.
  checksum         String?
  sizeBytes        BigInt?
  /// Whether the stored dump was encrypted at rest (required before any upload).
  encrypted        Boolean        @default(false)
  /// Honest detail when a snapshot/restore could not be effected.
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([backendServiceId, createdAt])
}

/// A user-facing, NON-destructive point-in-time backup of an app's Postgres
/// database (Phase 10 data safety). Distinct from DbSnapshot: a snapshot is the
/// cost-control path that deletes the live DB afterward, whereas a backup only
/// preserves data and never deletes anything. Like snapshots, a backup is only
/// ever STORED after a real, checksum-verified export to a configured PRIVATE,
/// encrypted store — raw dumps are NEVER placed on public IPFS. Operator-only
/// pointers; the owner only ever sees timestamps/status/size, never locationRef.
model DbBackup {
  id               String         @id @default(uuid())
  backendServiceId String
  backendService   BackendService @relation(fields: [backendServiceId], references: [id], onDelete: Cascade)
  /// PENDING | EXPORTING | STORED | FAILED.
  status           String         @default("PENDING")
  /// AUTO (scheduler) | MANUAL (owner-triggered).
  kind             String         @default("AUTO")
  /// Opaque pointer to the configured private store + location; null until a
  /// real export to a real store has happened. Never exposed to end users.
  storageProvider  String?
  locationRef      String?
  /// Integrity check of the (encrypted) dump; set only when STORED.
  checksum         String?
  sizeBytes        BigInt?
  /// Whether the stored dump was encrypted at rest (required before any upload).
  encrypted        Boolean        @default(false)
  /// Honest detail when a backup could not be effected.
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([backendServiceId, createdAt])
}

/// Phase 4 metering ledger: periodic, append-only samples of an app backend's
/// cumulative provider usage. Overage for a billing cycle is computed from real
/// closed-cycle samples (positive deltas, reset-aware) — never fabricated. With
/// metering inert (GO-LIVE off or Railway unconfigured) no samples are written,
/// so overage honestly stays 0/METERING_UNAVAILABLE. Operator-only data.
model UsageSample {
  id                  String         @id @default(uuid())
  backendServiceId    String
  backendService      BackendService @relation(fields: [backendServiceId], references: [id], onDelete: Cascade)
  /// Where the sample came from (e.g. RAILWAY_ESTIMATED_USAGE). Never guessed.
  source              String
  /// Cumulative network usage (RX+TX, GB) observed at sampledAt for the
  /// provider's then-current billing period.
  networkGb           Float
  /// The provider billing-period start this cumulative reading belongs to, so a
  /// period reset (cumulative value dropping) is detected, not read as negative.
  providerPeriodStart DateTime?
  sampledAt           DateTime       @default(now())

  @@index([backendServiceId, sampledAt])
}

/// Operator-only cost-exposure alerts (e.g. approaching the live-DB cap). Kept
/// separate from end-user Notification (which requires a userId) — these are
/// surfaced only on the operator cost dashboard, never to end users.
model OperatorAlert {
  id        String    @id @default(uuid())
  /// CAP_WARNING | CAP_REACHED
  type      String
  message   String
  /// JSON-encoded structured context (counts, threshold) for the dashboard.
  context   String?
  /// Dedup key so a given crossing is alerted once until cleared/re-crossed.
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

/// Single-row operator configuration for idle-DB cost control (Phase 7).
model OperatorCostControlConfig {
  /// Always the literal id "singleton" — there is exactly one config row.
  id                    String   @id @default("singleton")
  /// Max simultaneously LIVE databases across the account (absolute exposure).
  maxLiveDbs            Int      @default(10)
  /// Warn the operator when live DBs reach this percent of the cap.
  warnAtPercent         Int      @default(80)
  /// Days of zero provider-side activity before a DB is marked DORMANT_PENDING.
  inactivityDays        Int      @default(7)
  /// Master switch for the snapshot -> delete -> restore path. Stays OFF until a
  /// private snapshot store is configured AND Railway provisioning is live;
  /// while OFF, dormant DBs are flagged but never snapshotted or deleted.
  snapshotDeleteEnabled Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

/// Single-row master "GO-LIVE" switch for the whole backend lane (WOODSTICK 3
/// Phases 2-7). The operator flips this AFTER paying the landlord (Railway) and
/// adding the required keys. While goLiveEnabled is false EVERYTHING in the
/// backend lane stays inert: provisioning returns an honest 503/PENDING, no
/// usage is metered or charged, and no dormancy snapshot/delete ever runs.
/// Per-capability readiness is still gated on the specific real-world keys each
/// capability needs (see goLiveService.goLiveReadiness), so flipping this switch
/// can never by itself fake readiness or start billing for a missing dependency.
model GoLiveConfig {
  /// Always the literal id "singleton" — there is exactly one row.
  id                     String   @id @default("singleton")
  /// The master switch. False until the operator has paid Railway + added keys.
  goLiveEnabled          Boolean  @default(false)
  /// Operator attestation that the Railway account is paid (this cannot be
  /// verified programmatically). Provisioning stays blocked until this is true,
  /// so we never attempt to run up a bill on an unpaid landlord account.
  railwayPaidAttestation Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model Subscription {
  id          String   @id @default(uuid())
  /// 'FREE' or 'PREMIUM'
  tier        String
  piTxId      String?  @unique
  amount      Decimal  @db.Decimal(18, 8)
  currency    String
  /// 'active' or 'cancelled'
  status      String
  /// Pi environment the payment was made against: 'testnet' or 'mainnet'.
  env         String   @default("testnet")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// PiRC2 recurring subscription (Pi Network's on-chain subscription standard).
///
/// The subscriber grants a one-time spending allowance to the PiRC2 contract;
/// funds stay in their wallet and the billing scheduler draws one `amountPerCycle`
/// per interval (via the contract's transfer_from) until the allowance horizon
/// (`cyclesAuthorized`) is reached or the subscription is cancelled.
model PiSubscription {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  /// Granted tier while active (currently always 'PREMIUM').
  tier               String   @default("PREMIUM")
  /// PENDING_APPROVAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status             String   @default("PENDING_APPROVAL")
  /// On-chain account that granted the allowance.
  subscriberAddress  String?
  /// PiRC2 subscription smart-contract id this allowance targets.
  contractId         String?
  /// PiRC2 on-chain service id (u64, stored as string) this subscription belongs
  /// to. Required to drive the contract's batch process(merchant, service_id, ...).
  onChainServiceId   String?
  /// PiRC2 on-chain subscription id (sub_id, u64 as string) returned by the
  /// contract's subscribe(). Used for honest per-subscription on-chain reconcile.
  onChainSubId       String?
  /// The on-chain tx hash that granted the spending allowance (the subscriber's
  /// one-time subscribe()/approve() transaction).
  approvalTxId       String?  @unique
  currency           String   @default("PI")
  /// Amount drawn each billing cycle.
  amountPerCycle     Decimal  @db.Decimal(18, 8)
  /// Total approved spending limit (amountPerCycle * cyclesAuthorized).
  allowanceTotal     Decimal  @db.Decimal(18, 8)
  /// Remaining un-drawn allowance.
  allowanceRemaining Decimal  @db.Decimal(18, 8)
  /// Billing interval length in days.
  intervalDays       Int      @default(30)
  /// Max number of cycles the allowance authorizes (billing horizon).
  cyclesAuthorized   Int
  /// Cycles successfully billed so far.
  cyclesBilled       Int      @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// When the next charge should be attempted (null once horizon reached).
  nextBillingAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  events             BillingEvent[]

  @@index([userId])
  @@index([status, nextBillingAt])
  @@index([contractId, onChainServiceId])
}

/// Immutable log of subscription lifecycle / on-chain billing events. These are
/// what the app tracks subscription status from.
model BillingEvent {
  id             String         @id @default(uuid())
  subscriptionId String
  subscription   PiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// APPROVAL | CHARGE | RENEWAL | CANCELLATION | INSUFFICIENT_FUNDS | EXPIRY
  type           String
  /// SUCCESS | FAILED
  status         String
  amount         Decimal?       @db.Decimal(18, 8)
  txId           String?
  periodStart    DateTime?
  periodEnd      DateTime?
  message        String?
  createdAt      DateTime       @default(now())

  @@index([subscriptionId])
}

model PaymentQuote {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  /// Catalog plan key being quoted: 'BUILDER' | 'PRO' | 'TIER4'.
  plan           String
  /// Dollar subtotal in integer cents (plan price + overage).
  dollarCents    Int
  /// Accrued overage in cents. Always 0 until Phase 4 metering exists.
  overageCents   Int      @default(0)
  /// Live Pi/USD rate this quote was priced at.
  piUsdRate      Decimal  @db.Decimal(18, 8)
  /// Where piUsdRate came from (matches PI_PRICE_SOURCE, e.g. 'coingecko').
  source         String
  /// When the source last observed that rate.
  observedAt     DateTime
  /// Conversion buffer applied, in basis points (default 400 = 4%).
  bufferBps      Int      @default(400)
  /// Pi owed = (dollar / piUsd) * (1 + buffer), rounded up to 7 dp.
  quotedPiAmount Decimal  @db.Decimal(18, 8)
  /// Pi environment this quote targets: 'testnet' | 'mainnet'.
  env            String   @default("testnet")
  /// PENDING | PAID | EXPIRED | CANCELLED
  status         String   @default("PENDING")
  /// Set once a Pi payment is created/linked against this quote.
  paymentId      String?  @unique
  /// On-chain tx hash once the linked payment completes.
  txid           String?  @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

/// A canonical, DOLLAR-denominated bill for one billing cycle. The dollar total
/// is the source of truth; the Pi amount is produced on demand via the Phase 5
/// quote engine at settlement time (and never blocks recording the debt). An
/// invoice records what is owed — creating or pricing one charges NOTHING.
model Invoice {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  /// Optional links to the subscription this cycle bills (no FK relation kept
  /// intentionally to avoid coupling the two billing models).
  subscriptionId   String?
  piSubscriptionId String?
  /// Catalog plan key this cycle bills (e.g. 'BUILDER' | 'PRO' | 'TIER4').
  plan           String
  cycleStart     DateTime
  cycleEnd       DateTime
  /// Plan subtotal in integer cents.
  subscriptionCents Int
  /// Accrued overage in cents. 0 until Phase 4 metering exists.
  overageCents   Int      @default(0)
  /// Where overageCents came from; 'METERING_DEFERRED' until Phase 4.
  overageSource  String   @default("METERING_DEFERRED")
  /// subscriptionCents + overageCents.
  totalCents     Int
  currency       String   @default("USD")
  /// OPEN | PAID | OVERDUE | VOID. (Pause state lives on BackendService.)
  status         String   @default("OPEN")
  dueAt          DateTime
  /// Apps may be paused once now > graceUntil and the invoice is still unpaid.
  graceUntil     DateTime
  paidAt         DateTime?
  /// Most recent Pi quote produced for settling this invoice (display only).
  latestPaymentQuoteId String?
  /// Set only once a real, verified Pi settlement is linked (deferred cutover).
  paymentId      String?  @unique
  txid           String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status, dueAt])
  @@index([status, graceUntil])
}

/// A user-facing, in-app notification (billing lifecycle, etc.). Pi-only app
/// — no email delivery exists or is planned; this store is the single source
/// of truth and the client reads notifications from here only.
model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// INVOICE_DUE | INVOICE_OVERDUE | APPS_PAUSED | APPS_RESUMED
  /// | CAP_WARNING_80 | CAP_REACHED_100 (cap types require Phase 4 metering and
  /// are never emitted until real usage data exists).
  type       String
  message    String
  /// Loosely links the notification to an invoice when relevant (no FK).
  invoiceId  String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  /// DB-level dedup for "notify once per event": at most one notification per
  /// (user, type, invoice). NULL invoiceId rows are exempt (Postgres treats
  /// NULLs as distinct), which is intended — only invoice-linked alerts dedup.
  @@unique([userId, type, invoiceId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// In-app support ticket. Pi-only app: there is no email support channel, so
/// this is the sole way for a user to reach the operator. Honest lifecycle —
/// OPEN until an operator or the user closes it; no fake "resolved" auto-flip.
model SupportTicket {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  subject   String
  status    String               @default("OPEN")
  /// OPEN | AWAITING_OPERATOR | AWAITING_USER | CLOSED
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  closedAt  DateTime?
  messages  SupportTicketMessage[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// A single message within a support ticket thread. `fromOperator` is false
/// for every message the user sends; the operator side (hPanel/CLI) sets it
/// true when replying. There is no email delivery of these — users see
/// replies in-app via GET /api/support/tickets/:id.
model SupportTicketMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id])
  fromOperator Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Watchdog: a single HTTP probe result for an ACTIVE deployment.
model WatchdogCheck {
  id             String     @id @default(uuid())
  deploymentId   String
  deployment     Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  /// up | down | degraded
  status         String
  /// HTTP status code returned by the site. Null on network error/timeout.
  httpCode       Int?
  /// Round-trip time in milliseconds (capped at probe timeout on failure).
  responseTimeMs Int
  checkedAt      DateTime   @default(now())

  @@index([deploymentId, checkedAt])
}

/// Watchdog: an open/closed availability incident for a deployment.
/// An incident opens when a check transitions from "up" to "down/degraded"
/// and closes when the site returns to "up".
model WatchdogIncident {
  id           String     @id @default(uuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  url          String
  openedAt     DateTime   @default(now())
  /// Null while the incident is open.
  closedAt     DateTime?
  reason       String

  @@index([deploymentId, openedAt])
}
